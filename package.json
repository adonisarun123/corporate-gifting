{
  "name": "corporate-gifting",
  "version": "0.1.0",
  "private": true,
  "description": "Corporate Gifting Hub \u2014 enquiry-led B2B gifting platform (Next.js, Neon PostgreSQL, Drizzle)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-local": "tsx scripts/reset-local.ts",
    "db:generate": "drizzle-kit generate",
    "jobs:dispatch": "tsx scripts/dispatch-outbox.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "db:seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "nanoid": "6.0.1",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@neon/config": "1.8.0",
    "@neon/env": "1.4.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
