# ---- Application ----
APP_ORIGIN=http://localhost:3000
# APP_ENV=production is set on the production deployment only (guards dev-only features)
APP_ENV=development

# ---- Neon PostgreSQL (project twilight-pond-28025207, branch production) ----
# Runtime traffic: POOLED endpoint (…-pooler.…), role = runtime app role (no BYPASSRLS, not table owner).
DATABASE_URL=postgresql://cgh_app:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Migrations/admin: DIRECT endpoint, owner role. Never used at runtime.
DATABASE_URL_DIRECT=postgresql://neondb_owner:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Password to assign to the cgh_app runtime role when the bootstrap migration creates it.
APP_DB_PASSWORD=change-me

# ---- Identity ----
# "dev" = header/cookie-based dev users from the seed (local only). "clerk" = Clerk.
AUTH_PROVIDER=dev
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ---- Sessions / signing ----
SESSION_SECRET=generate-32-bytes-base64
QUOTE_LINK_SECRET=generate-32-bytes-base64

# ---- Providers (adapters fall back to logging when blank) ----
RESEND_API_KEY=
EMAIL_FROM="Corporate Gifting Hub <noreply@example.com>"
CLOUDINARY_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
POSTHOG_KEY=

# ---- Feature flags (P1/P2 stay off) ----
FEATURE_CONFIGURABLE_COMBOS=false
FEATURE_AI_CONCIERGE=false
FEATURE_BUYER_ORGS=false
